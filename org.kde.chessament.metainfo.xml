<component type="desktop-application">
  <id>org.kde.chessament</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Chessament</name>
  <name xml:lang="eu">Chessament</name>
  <name xml:lang="gl">Chessament</name>
  <name xml:lang="he">Chessament</name>
  <summary>Chess tournament manager</summary>
  <summary xml:lang="eu">Xake txapelketa kudeatzailea</summary>
  <summary xml:lang="gl">Xestor de torneos de xadrez</summary>
  <summary xml:lang="he">מנהל תחרויות שחמט</summary>
  <description>
    <p>Chessament is a chess tournament manager. It currently supports individual Swiss-system tournaments.</p>
    <p xml:lang="eu">Chessament xake txapelketa kudeatzaile bat da. Gaur egun, sistema suitzarreko banakako txapelketak onartzen ditu.</p>
    <p xml:lang="gl">Chessament é un xestor de torneos de xadrez. Actualmente permite torneos individuais mediante o sistema suízo.</p>
    <p xml:lang="he">Chessament הוא מנהל תחרויות שחמט. כרגע הוא תומך בתחרויות עצמאיות בשיטה השווייצרית.</p>
  </description>
  <icon type="stock">org.kde.chessament</icon>
