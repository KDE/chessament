  <bookinfo>
    <title
>Руководство пользователя &chessament;</title>
    <authorgroup>
      <author
>&Manuel.Alcaraz.Zambrano; &Manuel.Alcaraz.Zambrano.mail;</author>
      <othercredit role="translator"
><firstname
