></keycombo
> </shortcut
> <guimenu
>Configurações</guimenu
> <guimenuitem
>Configurar atalhos do teclado…</guimenuitem
> </menuchoice>
						</term>
						<listitem>
							<para
><action
>Abre</action
> a janela de atalhos do teclado. </para>
						</listitem>
					</varlistentry>
					<varlistentry id="menu-settings-chessament">
						<term>
							<menuchoice
><shortcut
> <keycombo action="simul"
>&Ctrl;&Shift;<keycap
>,</keycap
></keycombo
> </shortcut
> <guimenu
>Configurações</guimenu
> <guimenuitem
>Configurar o Chessament…</guimenuitem
> </menuchoice>
						</term>
						<listitem>
							<para
