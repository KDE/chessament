		<sect1 id="reference-command-line-options">
			<title
>Opções da linha de comando</title>
			<variablelist>
			  <varlistentry>
					<term>
						<userinput
><command
>chessament</command
> <option
>--import-trf <replaceable
>arquivo</replaceable
></option
> </userinput>
					</term>
					<listitem>
						<para
>Importa um arquivo de relatório de torneio (<acronym
>TRF</acronym
>) como um novo torneio. </para>
					</listitem>
			  </varlistentry>
			</variablelist>
		</sect1>
	</chapter>

